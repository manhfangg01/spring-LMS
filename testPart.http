@baseUrl = http://localhost:8000/api
@examId = 1
@accessToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJtYW5oY3V0bzc3N0BnbWFpbC5jb20iLCJpYXQiOjE3NzAwMTk4MTEsImV4cCI6MTc3MDYyNDYxMX0.nN8SIqLE9LPMIZf0Ut-RMfMw27wmx7iExjMGxFfEV7GnlMg6OejzLCGbqTxg6Q1Y4osXwek6pvThDlgq7wt7Rg

### Get all parts (Paginated)
GET {{baseUrl}}/parts?page=0&size=10
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get a specific part by ID
GET {{baseUrl}}/parts/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Create a new Part
POST {{baseUrl}}/exams/{{examId}}/parts
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "Part 1: Listening",
  "passage": "Listen to the audio and answer questions.",
  "audioUrl": "http://example.com/audio.mp3",
  "description": "Part 1 description"
}

### Update an existing Part
PATCH {{baseUrl}}/parts/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "Part 1: Listening (Revised)",
  "description": "Updated instructions for candidates.",
  "passage": "Updated passage content",
  "audioUrl": "http://example.com/audio_updated.mp3"
}

### Delete a Part
DELETE {{baseUrl}}/parts/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

