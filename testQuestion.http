@baseUrl = http://localhost:8000/api/questions
@examId = 1
@accessToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJtYW5oY3V0bzc3N0BnbWFpbC5jb20iLCJpYXQiOjE3NzAwMTk4MTEsImV4cCI6MTc3MDYyNDYxMX0.nN8SIqLE9LPMIZf0Ut-RMfMw27wmx7iExjMGxFfEV7GnlMg6OejzLCGbqTxg6Q1Y4osXwek6pvThDlgq7wt7Rg

### Get all questions (Paginated)
GET {{baseUrl}}?page=0&size=10
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get a specific question by ID
# Replace '1' with a valid question ID from the previous request
GET {{baseUrl}}/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Create a new Question
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "What is the capital of France?",
  "examId": {{examId}},
  "questionType": "MULTIPLE_CHOICE",
  "explanation": "Paris is the capital and most populous city of France.",
  "questionOptions": [
    {
      "content": "Berlin",
      "isCorrect": false
    },
    {
      "content": "London",
      "isCorrect": false
    },
    {
      "content": "Paris",
      "isCorrect": true
    },
    {
      "content": "Madrid",
      "isCorrect": false
    }
  ]
}

### Update an existing Question
# Replace '1' with the ID of the question you just created
PUT {{baseUrl}}/4
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "What is the capital of France? (Updated) chap2dff",
  "examId": {{examId}},
   "questionType": "MULTIPLE_CHOICE",
  "questionOptions": [
    {
      "content": "Berlin",
      "isCorrect": false
    },
    {
      "content": "Paris",
      "isCorrect": true
    },
    {
      "content": "Lyon",
      "isCorrect": false
    }
  ]
}

### Delete a Question
# Replace '1' with the ID of the question you want to delete
DELETE {{baseUrl}}/3
Content-Type: application/json
Authorization: Bearer {{accessToken}}

### Get all questions by Exam ID
GET {{baseUrl}}/exam/{{examId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}
